{
  "expo": {
    "name": "eBike",
    "slug": "ebike",
    "scheme": "ebike",
    "version": "1.8.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ebikeland.app",
      "buildNumber": "25",
      "infoPlist": {
        "NSCameraUsageDescription": "eBike uses the camera to capture photos inside the app before you publish them.",
        "NSPhotoLibraryUsageDescription": "eBike accesses your photo library to let you choose media that appears in the app.",
        "NSLocationWhenInUseUsageDescription": "eBike uses your location to display your position on in-app maps and surface nearby points of interest.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "eBike needs background location while you are marked available so customers can find you when the app is in the background.",
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.ebike.app",
      "versionCode": 25,
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "eBike needs background location while you are marked available so customers can find you when the app is in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "kotlinVersion": "2.1.20"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./icon.png",
    "splash": {
      "image": "./assets/images/splash-bg.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#052e16"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d8db8d6d-30a7-4c1d-bcdb-6fa7f5b601e3"
      }
    },
    "owner": "elvisebike"
  }
}
